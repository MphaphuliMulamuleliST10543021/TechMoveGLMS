
@model IEnumerable<TechMoveGLMS.Web.Models.Contract>

@{
    ViewData["Title"] = "Contracts";
    var contracts = Model.ToList();
}

<div class="container-fluid py-4">

    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
        <div>
            <h1 class="fw-bold mb-1">Contracts</h1>
            <p class="text-muted mb-0">
                Manage client agreements, contract dates and signed documents.
            </p>
        </div>

        <a asp-action="Create" class="btn btn-primary">
            + Create Contract
        </a>
    </div>

    @if (TempData["SuccessMessage"] is string successMessage)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @successMessage
            <button type="button" class="btn-close"
                    data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (TempData["ErrorMessage"] is string errorMessage)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @errorMessage
            <button type="button" class="btn-close"
                    data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="row g-3 mb-4">
        <div class="col-12 col-md-4">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body">
                    <p class="text-muted mb-1">Total Contracts</p>
                    <h3 class="fw-bold mb-0">@contracts.Count</h3>
                </div>
            </div>
        </div>

        <div class="col-12 col-md-4">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body">
                    <p class="text-muted mb-1">Active Contracts</p>
                    <h3 class="fw-bold text-success mb-0">
                        @contracts.Count(c =>
                            string.Equals(c.Status, "Active",
                                StringComparison.OrdinalIgnoreCase))
                    </h3>
                </div>
            </div>
        </div>

        <div class="col-12 col-md-4">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body">
                    <p class="text-muted mb-1">Signed PDFs Available</p>
                    <h3 class="fw-bold mb-0">
                        @contracts.Count(c =>
                            !string.IsNullOrWhiteSpace(c.SignedPdfFileName))
                    </h3>
                </div>
            </div>
        </div>
    </div>

    <div class="card border-0 shadow-sm">
        
<div class="card-header bg-white py-3">
    <h5 class="mb-0">Contract Register</h5>
    <p class="text-muted small mb-0">
        Filter contracts by status and contract dates.
    </p>
</div>

<div class="card-body border-bottom bg-light">
    <form asp-action="Index" method="get">
        <div class="row g-3 align-items-end">
            <div class="col-12 col-md-4">
                <label for="status" class="form-label">Status</label>
                <select id="status" name="status" class="form-select">
                    <option value="">All statuses</option>
                    @foreach (var item in new[] { "Draft", "Active", "Expired", "On Hold" })
                    {
                        if (string.Equals(
                            (string?)ViewBag.StatusFilter,
                            item,
                            StringComparison.OrdinalIgnoreCase))
                        {
                            <option value="@item" selected>@item</option>
                        }
                        else
                        {
                            <option value="@item">@item</option>
                        }
                    }
                </select>
            </div>

            <div class="col-12 col-md-3">
                <label for="startDate" class="form-label">Start date from</label>
                <input type="date"
                       id="startDate"
                       name="startDate"
                       value="@ViewBag.StartDateFilter"
                       class="form-control" />
            </div>

            <div class="col-12 col-md-3">
                <label for="endDate" class="form-label">End date to</label>
                <input type="date"
                       id="endDate"
                       name="endDate"
                       value="@ViewBag.EndDateFilter"
                       class="form-control" />
            </div>

            <div class="col-12 col-md-2 d-flex gap-2">
                <button type="submit" class="btn btn-primary">Filter</button>
                <a asp-action="Index" class="btn btn-outline-secondary">Reset</a>
            </div>
        </div>
    </form>
</div>


        <div class="card-body">
            @if (!contracts.Any())
            {
                <div class="text-center py-5">
                    <h5>No contracts found</h5>
                    <p class="text-muted">
                        Create your first contract to get started.
                    </p>
                    <a asp-action="Create" class="btn btn-primary">
                        Create Your First Contract
                    </a>
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle">
                        <thead class="table-light">
                            <tr>
                                <th>Contract ID</th>
                                <th>Client</th>
                                <th>Service Level</th>
                                <th>Start Date</th>
                                <th>End Date</th>
                                <th>Status</th>
                                <th>Signed PDF</th>
                                <th>Actions</th>
                            </tr>
                        </thead>

                        <tbody>
                        @foreach (var contract in contracts)
                        {
                            <tr>
                                <td class="fw-semibold">#@contract.Id</td>

                                <td>
                                    @(contract.Client?.Name ?? "Unknown client")
                                </td>

                                <td>@contract.ServiceLevel</td>

                                <td>@contract.StartDate.ToString("dd MMM yyyy")</td>

                                <td>@contract.EndDate.ToString("dd MMM yyyy")</td>

                                <td>
                                    @switch (contract.Status)
                                    {
                                        case "Active":
                                            <span class="badge rounded-pill bg-success">
                                                Active
                                            </span>
                                            break;

                                        case "Draft":
                                            <span class="badge rounded-pill bg-secondary">
                                                Draft
                                            </span>
                                            break;

                                        case "Expired":
                                            <span class="badge rounded-pill bg-danger">
                                                Expired
                                            </span>
                                            break;

                                        case "On Hold":
                                            <span class="badge rounded-pill bg-warning text-dark">
                                                On Hold
                                            </span>
                                            break;

                                        default:
                                            <span class="badge rounded-pill bg-secondary">
                                                @contract.Status
                                            </span>
                                            break;
                                    }
                                </td>

                                <td>
                                    @if (!string.IsNullOrWhiteSpace(contract.SignedPdfFileName))
                                    {
                                        <a asp-action="DownloadPdf"
                                           asp-route-id="@contract.Id"
                                           class="btn btn-sm btn-outline-success mb-1">
                                            Download PDF
                                        </a>

                                        <br />

                                        <a asp-action="UploadPdf"
                                           asp-route-id="@contract.Id">
                                            Replace PDF
                                        </a>
                                    }
                                    else
                                    {
                                        <a asp-action="UploadPdf"
                                           asp-route-id="@contract.Id"
                                           class="btn btn-sm btn-outline-secondary">
                                            Upload PDF
                                        </a>
                                    }
                                </td>

                                <td>
                                    <div class="d-flex flex-wrap gap-2">
                                        <a asp-action="Edit"
                                           asp-route-id="@contract.Id"
                                           class="btn btn-sm btn-outline-primary">
                                            Edit
                                        </a>

                                        <a asp-action="Delete"
                                           asp-route-id="@contract.Id"
                                           class="btn btn-sm btn-outline-danger">
                                            Delete
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</div>
