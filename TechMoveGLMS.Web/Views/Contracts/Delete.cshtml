
@model TechMoveGLMS.Web.Models.Contract

@{
    ViewData["Title"] = "Delete Contract";
}

<div class="container py-4">
    <div class="card border-danger shadow-sm">
        <div class="card-body p-4">
            <h1 class="text-danger">Delete Contract #@Model.Id</h1>

            <p>Are you sure you want to delete this contract?</p>

            <dl class="row">
                <dt class="col-sm-3">Client</dt>
                <dd class="col-sm-9">@(Model.Client?.Name ?? "Unknown")</dd>

                <dt class="col-sm-3">Service level</dt>
                <dd class="col-sm-9">@Model.ServiceLevel</dd>

                <dt class="col-sm-3">Dates</dt>
                <dd class="col-sm-9">
                    @Model.StartDate.ToString("yyyy-MM-dd")
                    to
                    @Model.EndDate.ToString("yyyy-MM-dd")
                </dd>

                <dt class="col-sm-3">Status</dt>
                <dd class="col-sm-9">@Model.Status</dd>
            </dl>

            @if (!string.IsNullOrWhiteSpace(Model.SignedPdfFileName))
            {
                <p class="text-warning">
                    The signed PDF associated with this contract will also
                    be removed if the database deletion succeeds.
                </p>
            }

            <form asp-action="Delete" asp-route-id="@Model.Id" method="post">
                @Html.AntiForgeryToken()

                <button type="submit" class="btn btn-danger">
                    Confirm Delete
                </button>

                <a asp-action="Index" class="btn btn-outline-secondary">
                    Cancel
                </a>
            </form>
        </div>
    </div>
</div>
