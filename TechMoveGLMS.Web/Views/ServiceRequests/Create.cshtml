@model TechMoveGLMS.Web.Models.ServiceRequest
@using TechMoveGLMS.Web.Models

@{
    ViewData["Title"] = "Create Service Request";
    var contracts = ViewBag.Contracts as IEnumerable<Contract>
                    ?? Enumerable.Empty<Contract>();
}

<h1>Create Service Request</h1>
<p class="text-muted">Record a logistics service request and its cost.</p>

@if (!contracts.Any())
{
    <div class="alert alert-warning">
        There are no currently active contracts available for service requests.
    </div>
}
else
{
    <div class="card">
        <div class="card-body p-4">
            <form asp-action="Create" method="post">
                @Html.AntiForgeryToken()

                <div asp-validation-summary="ModelOnly"
                     class="text-danger mb-3"></div>

                <div class="mb-3">
                    <label asp-for="ContractId" class="form-label">
                        Contract
                    </label>
                    <select asp-for="ContractId" class="form-select">
                        <option value="">-- Select a contract --</option>
                        @foreach (var contract in contracts)
                        {
                            <option value="@contract.Id">
                                Contract #@contract.Id —
                                @(contract.Client?.Name ?? "Unknown client")
                            </option>
                        }
                    </select>
                    <span asp-validation-for="ContractId"
                          class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Description" class="form-label">
                        Description
                    </label>
                    <textarea asp-for="Description"
                              class="form-control"
                              rows="3"></textarea>
                    <span asp-validation-for="Description"
                          class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="CostUsd" class="form-label">
                        Cost (USD)
                    </label>
                    <input asp-for="CostUsd"
                           type="number"
                           min="0.01"
                           step="0.01"
                           class="form-control" />
                    <span asp-validation-for="CostUsd"
                          class="text-danger"></span>
                    <small class="text-muted">
                        The ZAR amount is calculated using the current
                        exchange rate when you submit the request.
                    </small>
                </div>

                <button type="submit" class="btn btn-primary">
                    Create Request
                </button>
                <a asp-action="Index" class="btn btn-secondary">Cancel</a>
            </form>
        </div>
    </div>
}

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}