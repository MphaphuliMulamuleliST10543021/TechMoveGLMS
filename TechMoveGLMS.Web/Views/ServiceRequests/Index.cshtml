
@model IEnumerable<TechMoveGLMS.Web.Models.ServiceRequest>

@{
    ViewData["Title"] = "Service Requests";
    var requests = Model.ToList();
}

<div class="container-fluid py-4">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
        <div>
            <h1 class="fw-bold mb-1">Service Requests</h1>
            <p class="text-muted mb-0">
                Track logistics requests and their USD and ZAR costs.
            </p>
        </div>

        <a asp-action="Create" class="btn btn-primary">
            + Create Request
        </a>
    </div>

    @if (TempData["SuccessMessage"] is string message)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @message
            <button type="button" class="btn-close"
                    data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="row g-3 mb-4">
        <div class="col-12 col-md-4">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body">
                    <p class="text-muted mb-1">Total Requests</p>
                    <h3 class="fw-bold mb-0">@requests.Count</h3>
                </div>
            </div>
        </div>

        <div class="col-12 col-md-4">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body">
                    <p class="text-muted mb-1">Pending Requests</p>
                    <h3 class="fw-bold text-warning mb-0">
                        @requests.Count(r => r.Status == "Pending")
                    </h3>
                </div>
            </div>
        </div>

        <div class="col-12 col-md-4">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body">
                    <p class="text-muted mb-1">Total Cost (USD)</p>
                    <h3 class="fw-bold mb-0">
                        @requests.Sum(r => r.CostUsd).ToString("N2")
                    </h3>
                    <small class="text-muted">USD</small>
                </div>
            </div>
        </div>
    </div>

    <div class="card border-0 shadow-sm">
        <div class="card-header bg-white py-3">
            <h5 class="mb-0">Request Register</h5>
        </div>

        <div class="card-body">
            @if (!requests.Any())
            {
                <div class="text-center py-5">
                    <h5>No service requests yet</h5>
                    <p class="text-muted">
                        Create a request against a currently active contract.
                    </p>
                    <a asp-action="Create" class="btn btn-primary">
                        Create First Request
                    </a>
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle">
                        <thead class="table-light">
                            <tr>
                                <th>ID</th>
                                <th>Client</th>
                                <th>Contract</th>
                                <th>Description</th>
                                <th class="text-end">Cost (USD)</th>
                                <th class="text-end">Cost (ZAR)</th>
                                <th>Status</th>
                                <th>Created</th>
                            </tr>
                        </thead>
                        <tbody>
                        @foreach (var request in requests)
                        {
                            <tr>
                                <td class="fw-semibold">#@request.Id</td>
                                <td>
                                    @(request.Contract?.Client?.Name ?? "Unknown client")
                                </td>
                                <td>#@request.ContractId</td>
                                <td>@request.Description</td>
                                <td class="text-end">
                                    $@request.CostUsd.ToString("N2")
                                </td>
                                <td class="text-end">
                                    R @request.CostZar.ToString("N2")
                                </td>
                                <td>
                                    @if (request.Status == "Pending")
                                    {
                                        <span class="badge bg-warning text-dark">Pending</span>
                                    }
                                    else if (request.Status == "Complete")
                                    {
                                        <span class="badge bg-success">Complete</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">
                                            @request.Status
                                        </span>
                                    }
                                </td>
                                <td>
                                    
@request.CreatedAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm")

                                </td>
                            </tr>
                        }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</div>
