
@model TechMoveGLMS.Web.Models.Client

@{
    ViewData["Title"] = "Edit Client";
}

<div class="mb-4">
    <a asp-action="Index" class="small">&larr; Back to Clients</a>
    <div class="text-uppercase text-success fw-bold small mt-3 mb-2">
        Client management
    </div>
    <h1>Edit Client</h1>
    <p class="text-muted">
        Update contact details for @Model.Name.
    </p>
</div>

<div class="card">
    <div class="card-body p-4">
        <form asp-action="Edit" asp-route-id="@Model.Id" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="Id" />

            <div asp-validation-summary="ModelOnly"
                 class="alert alert-danger"
                 role="alert"></div>

            <div class="row g-3">
                <div class="col-md-6">
                    <label asp-for="Name" class="form-label"></label>
                    <input asp-for="Name"
                           class="form-control"
                           maxlength="150" />
                    <span asp-validation-for="Name"
                          class="field-validation-error"></span>
                </div>

                <div class="col-md-6">
                    <label asp-for="Email" class="form-label"></label>
                    <input asp-for="Email"
                           type="email"
                           class="form-control"
                           maxlength="150" />
                    <span asp-validation-for="Email"
                          class="field-validation-error"></span>
                </div>

                <div class="col-md-6">
                    <label asp-for="ContactNumber" class="form-label"></label>
                    <input asp-for="ContactNumber"
                           type="tel"
                           class="form-control"
                           maxlength="30" />
                    <span asp-validation-for="ContactNumber"
                          class="field-validation-error"></span>
                </div>

                <div class="col-md-6">
                    <label asp-for="Region" class="form-label"></label>
                    <input asp-for="Region"
                           class="form-control"
                           maxlength="100" />
                    <span asp-validation-for="Region"
                          class="field-validation-error"></span>
                </div>
            </div>

            <div class="mt-4 pt-3 border-top d-flex gap-2">
                <button type="submit" class="btn btn-primary">
                    Save Changes
                </button>
                <a asp-action="Details"
                   asp-route-id="@Model.Id"
                   class="btn btn-outline-secondary">Cancel</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
